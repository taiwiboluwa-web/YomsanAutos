    { "source": "/experience", "destination": "/index.html" },
    { "source": "/experience/:path*", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact/:path*", "destination": "/index.html" },
    { "source": "/inventory", "destination": "/index.html" },
